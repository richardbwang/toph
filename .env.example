# Postgres connection string (Neon / Supabase / local). Required.
# Local:  postgresql://toph:toph@localhost:5432/toph
# Neon:   copy from Vercel → Storage → your database → .env.local tab
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional — enables Claude for turning voice-log answers into structured logs.
# Without it a keyword heuristic is used, so the demo works with no key.
ANTHROPIC_API_KEY=""
# Optional pin. Unset, the newest Sonnet is picked from the Models API at runtime.
# ANTHROPIC_MODEL="claude-sonnet-5"
